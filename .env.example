# Copy to .env — docker-compose injects these into the container, where
# config.yaml references them as ${VAR}. Keep .env out of git (it's gitignored).

# --- provider secrets (only set the ones you use) ---
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_ADMIN_KEY=
XAI_API_KEY=
# Optional alternative to OpenAI's Connect flow (ChatGPT OAuth, not an API key).
OPENAI_ACCESS_TOKEN=
OPENAI_ACCOUNT_ID=

# --- runtime ---
AIMON_LOG=info
AIMON_PORT=8080
# Codex/OpenAI OAuth loopback (http://localhost:1455/auth/callback). "off" disables it.
# AIMON_OAUTH_LISTEN=:1455

# Run the container as your host user so the bind-mounted ./data is writable.
# Find yours with: id -u ; id -g
UID=1000
GID=1000
